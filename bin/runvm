#!/bin/sh
# Use:
#   runvm             # default (ext4 root fs)
#   runvm -t btrfs    # to get a btrfs root fs
#   runvm -t xfs      # to get an XFS root fs

fstype=ext4
while getopts ":t:" opt; do
  case $opt in
    t) fstype=$OPTARG ;;
    :) echo "Option -$OPTARG requires an argument."; exit 1 ;;
  esac
done

set -eux

case $fstype in
  ext4|btrfs|xfs) ;;
  *) echo "unknown fstype, use ext4, btrfs, or xfs"; exit 1;;
esac

vm=$(nix-build --no-out-link --argstr fstype "$fstype" runvm.nix)
if size="$(stty size | tr ' ' :)"; then
  # hack to transfer console size
  export QEMU_KERNEL_PARAMS="styx.consolesize=$size"
fi
export NIX_DISK_IMAGE="/tmp/testvm-$UID-$fstype.qcow2"
keep=''
for arg; do
  case $arg in
    --keep) keep=1 ;;
  esac
done
[[ $keep ]] || rm -f "$NIX_DISK_IMAGE"

exec "$vm/bin/run-testvm-vm"
