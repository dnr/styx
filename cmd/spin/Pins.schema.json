{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dnr/styx/main/cmd/spin/Pins.schema.json",
  "title": "Spin pins",
  "description": "A Pins.json file generated by Spin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$doc", "$schema", "$storeDir", "$version", "pins"],
  "properties": {
    "$doc": {
      "type": "string"
    },
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "$storeDir": {
      "type": "string",
      "minLength": 1
    },
    "$version": {
      "const": "spin-1"
    },
    "pins": {
      "description": "Null in a newly initialized file, otherwise an array of pins.",
      "type": ["array", "null"],
      "items": {
        "$ref": "#/$defs/pin"
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "storePathName",
        "storePathHash",
        "outputHash",
        "originalUrl",
        "resolvedUrl"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "storePathName": {
          "type": "string",
          "minLength": 1
        },
        "storePathHash": {
          "type": "string",
          "pattern": "^[0-9abcdfghijklmnpqrsvwxyz]{32}$"
        },
        "outputHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "originalUrl": {
          "type": "string",
          "format": "uri"
        },
        "resolvedUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
